cabal-version:      3.0
name:               otb
version:            0.1.0
synopsis:           One-Take Bach — score-to-performance interpretation compiler
description:        Compiles **kern scores (Humdrum) into performed MIDI:
                    articulation, ornament realization, agogics, dynamics and
                    temperament as versioned, diffable rules over an immutable
                    corpus. Euterpea's Music algebra is the score representation.
license:            GPL-2.0-or-later
author:             Zach
build-type:         Simple
extra-doc-files:    README.md
extra-source-files:
    config/*.toml
    config/casting/*.json
    config/editions/*.krn
    examples/*.json
    examples/*.scl
    tools/*.py
    tools/*.sh
    stack.yaml

common warnings
    ghc-options: -Wall -Wincomplete-record-updates -Wincomplete-uni-patterns

library
    import:           warnings
    hs-source-dirs:   src
    default-language: GHC2021
    default-extensions: OverloadedStrings LambdaCase DerivingStrategies
    exposed-modules:
        OTB.Units
        OTB.Pitch
        OTB.TempoGiusto
        OTB.Kern.Token
        OTB.Kern.Lexer
        OTB.Kern.Spine
        OTB.Kern.Parser
        OTB.Score
        OTB.Edition
        OTB.Eval
        OTB.Bridge
        OTB.Config
        OTB.Explain
        OTB.Interp
        OTB.Annotate
        OTB.Generate
        OTB.Instrument
        OTB.Tuning
        OTB.Interp.Agogics
        OTB.Interp.Articulation
        OTB.Interp.Dynamics
        OTB.Interp.Express
        OTB.Interp.Ornament
        OTB.Interp.Phrasing
        OTB.Player
        OTB.Emit.Midi
        OTB.Emit.Json
        OTB.Analysis.Counterpoint
        OTB.Analysis.Grouping
        OTB.Analysis.Harmony
        OTB.Analysis.Imitation
        OTB.Analysis.Parallelism
        OTB.Analysis.Subject
    build-depends:
        base >=4.17 && <5,
        deepseq,
        parallel,
        EuterpeaLite,
        text >=2.0,
        bytestring,
        containers,
        directory,
        filepath

executable otb
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    default-language: GHC2021
    default-extensions: OverloadedStrings LambdaCase DerivingStrategies
    build-depends:
        base,
        otb,
        text,
        bytestring,
        deepseq,
        containers,
        directory,
        filepath,
        optparse-applicative,
        parallel

test-suite otb-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    SMFReader
    default-language: GHC2021
    default-extensions: OverloadedStrings LambdaCase DerivingStrategies
    build-depends:
        base,
        otb,
        text,
        bytestring,
        directory,
        filepath,
        process,
        EuterpeaLite,
        tasty,
        tasty-hunit,
        tasty-quickcheck
